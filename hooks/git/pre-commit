#!/bin/sh
# Self-check of hooks and scripts before every commit (see AGENTS.md "Verifiche").
i="${GIT_INDEX_FILE:-.git/index}"; h=$(git hash-object "$i")
PY=$(command -v python || command -v python3)
"$PY" -X utf8 -I tests/run.py || exit 1
# a test that writes into the real index empties the commit (66e6bd4, commit -a)
[ "$(git hash-object "$i")" = "$h" ] || { echo "pre-commit: i test hanno cambiato l'indice"; exit 1; }

# Non-blocking branch naming check (safe in detached HEAD).
if b=$(git symbolic-ref --quiet --short HEAD 2>/dev/null); then
  if [ "$b" != "main" ] && ! printf '%s\n' "$b" | grep -Eq '^(office|home)/(feat|fix|refactor|docs|test|chore)/[a-z0-9][a-z0-9-]*$'; then
    echo "pre-commit: avviso: il branch '$b' non segue (office|home)/<tipo>/<slug> minuscolo" >&2
  fi
fi
